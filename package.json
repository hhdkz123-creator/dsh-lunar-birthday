{
  "name": "dsh-lunar-birthday-local",
  "version": "0.1.0",
  "description": "农历/公历生日提醒，复用大肥鱼气泡、动画和语音",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-package.mjs",
    "pack:release": "npm pack --ignore-scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhdkz123-creator/dsh-lunar-birthday.git"
  },
  "homepage": "https://github.com/hhdkz123-creator/dsh-lunar-birthday#readme",
  "bugs": {
    "url": "https://github.com/hhdkz123-creator/dsh-lunar-birthday/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-pet",
    "lunar",
    "birthday",
    "农历",
    "生日"
  ]
}
